[Unit]
Description=Network connections management service for Wiren Board devices
After=NetworkManager.service wb-hwconf-manager.service

[Service]
Type=simple
Restart=on-failure
RestartSec=2
User=root
ExecStart=/usr/lib/wb-connection-manager/wb-connection-manager
# 2: bad command-line arguments, 6: missing or invalid config
RestartPreventExitStatus=2 6
# 7: no managed connections in the config, nothing to do
SuccessExitStatus=7

[Install]
WantedBy=multi-user.target
